    "boost-property-tree",
    "boost-json",
    "boost-uuid",
    "boost-filesystem",
    "boost-iostreams",
    "boost-program-options",
    "openssl",
    {
      "name": "librdkafka",
      "features": [
        "ssl",
        "zlib",
        "zstd",
        {
          "name": "sasl",
          "platform": "linux"
        }
      ]
    },
    "lz4",
    "gtest"
  ],
  "overrides": [
    {
      "name": "librdkafka",
      "version": "2.15.1"
    }
  ]
}
